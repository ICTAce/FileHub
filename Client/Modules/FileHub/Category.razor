@namespace ICTAce.FileHub
@inherits ModuleBase

<h3>Categories</h3>

<RadzenTheme Theme="material" />

@if (IsLoading)
{
    <p><em>Loading...</em></p>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
else
{
    <div style="width: 100%; height: 500px; position: relative;">
        <RadzenTree Data="@TreeData" cho>
            <RadzenTreeLevel TextProperty="@(nameof(ListCategoryDto.Name))"
                             ChildrenProperty="@(nameof(ListCategoryDto.Children))"
                             HasChildren=@(e => (e as ListCategoryDto).Children.Any())>
            </RadzenTreeLevel>
        </RadzenTree>
    </div>
}

