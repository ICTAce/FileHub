@namespace ICTAce.FileHub
@inherits ModuleBase

@if (_filehubs == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Add FileHub" ResourceKey="Add" />
    <br />
    <br />
    @if (_filehubs.Count != 0)
    {
        <Pager Items="@_filehubs">
            <Header>
                <th style="width: 1px;">&nbsp;</th>
                <th style="width: 1px;">&nbsp;</th>
                <th>@Localizer["Name"]</th>
            </Header>
            <Row>
                <td><ActionLink Action="Edit" Parameters="@($"id=" + context.Id.ToString())" ResourceKey="Edit" /></td>
                <td><ActionDialog Header="Delete FileHub" Message="Are You Sure You Wish To Delete This FileHub?" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await Delete(context))" ResourceKey="Delete" Id="@context.Id.ToString()" /></td>
                <td>@context.Name</td>
            </Row>
        </Pager>
    }
    else
    {
        <p>@Localizer["Message.DisplayNone"]</p>
    }
}
