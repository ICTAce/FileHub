@namespace ICTAce.FileHub
@inherits ModuleBase

<RadzenTheme Theme="material" />

@if (_isLoading)
{
    <div class="text-center py-5">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large">
            <Template>Loading...</Template>
        </RadzenProgressBarCircular>
    </div>
}
else
{
    <div class="mb-3">
        <RadzenButton Icon="add" Text="Add New File" Click="@NavigateToAdd" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" />
    </div>

    @if (_files == null || !_files.Any())
    {
        <div class="alert alert-info">
            <i class="oi oi-info"></i> @Localizer["Message.DisplayNone"]
        </div>
    }
    else
    {
        <RadzenDataList Data="@_files" 
                        TItem="ListFileDto" 
                        PageSize="12" 
                        AllowPaging="true" 
                        PagerHorizontalAlign="HorizontalAlign.Center"
                        ShowPagingSummary="true">
            <Template Context="file">
                <RadzenCard>
                    <div class="row">
                        <div class="col-md-3 col-sm-12 text-center mb-3 mb-md-0">
                            @if (!string.IsNullOrEmpty(file.ImageName))
                            {
                                <RadzenImage Path="@GetImageUrl(file.ImageName)" 
                                           Class="file-card-image"
                                           AlternateText="@file.Name" />
                            }
                            else
                            {
                                <div class="file-thumbnail-placeholder">
                                    <i class="oi oi-file" style="font-size: 48px; opacity: 0.3;"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-9 col-sm-12 file-card-content">
                            <div class="mb-2">
                                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@file.Name" />
                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@file.FileSize" />
                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@($"{file.Downloads} downloads")" />
                            </div>
                            <div class="mt-3">
                                <ActionLink Action="Edit" 
                                          Parameters="@($"id={file.Id}")" 
                                          Text="Edit" 
                                          ResourceKey="Edit" 
                                          Class="btn btn-primary btn-sm me-2" />
                                <a href="@GetDownloadUrl(file.FileName)" 
                                   class="btn btn-secondary btn-sm me-2" 
                                   target="_blank"
                                   @onclick="@(() => OnDownloadClick(file))"
                                   @onclick:stopPropagation="true">
                                    <i class="oi oi-data-transfer-download"></i> Download
                                </a>
                                <ActionDialog Header="Delete File" 
                                            Message="Are You Sure You Wish To Delete This File?" 
                                            Action="Delete" 
                                            Security="SecurityAccessLevel.Edit" 
                                            Class="btn btn-danger btn-sm" 
                                            OnClick="@(async () => await Delete(file))" 
                                            ResourceKey="Delete" 
                                            Id="@file.Id.ToString()" />
                            </div>
                        </div>
                    </div>
                </RadzenCard>
            </Template>
        </RadzenDataList>
    }
}
