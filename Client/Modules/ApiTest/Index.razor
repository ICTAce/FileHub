@namespace ICTAce.FileHub.ApiTest
@inherits ModuleBase

<h3>ApiTest - Generic API Tester</h3>

<div class="row mb-3">
    <div class="col-md-2">
        <label class="form-label">Method</label>
        <select class="form-select" @bind="_method">
            <option>GET</option>
            <option>POST</option>
            <option>PUT</option>
            <option>DELETE</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Id</label>
        <input class="form-control" @bind="_id" type="number" />
    </div>
    <div class="col-md-2">
        <label class="form-label">ModuleId</label>
        <input class="form-control" @bind="_moduleId" type="number" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Relative URL</label>
        <input class="form-control" @bind="_url" placeholder="e.g. api/MyModule or api/MyModule/1" />
    </div>
</div>

<div class="mb-3">
    <label class="form-label">Body (JSON)</label>
    <textarea class="form-control" rows="6" @bind="_body"></textarea>
</div>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="SendRequest">Send</button>
    <button class="btn btn-outline-secondary me-2" @onclick="PrefillList">List (GET)</button>
    <button class="btn btn-outline-secondary me-2" @onclick="PrefillGet">Get (GET)</button>
    <button class="btn btn-outline-secondary me-2" @onclick="PrefillCreate">Create (POST)</button>
    <button class="btn btn-outline-secondary me-2" @onclick="PrefillUpdate">Update (PUT)</button>
    <button class="btn btn-outline-danger" @onclick="PrefillDelete">Delete (DELETE)</button>
</div>

@if (_loading)
{
    <p><em>Loading...</em></p>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (!string.IsNullOrEmpty(_responseStatus))
{
    <div class="mb-2"><strong>Response:</strong> @_responseStatus</div>
}

@if (!string.IsNullOrEmpty(_responseBody))
{
    <div class="card">
        <div class="card-body">
            <pre>@_responseBody</pre>
        </div>
    </div>
}
