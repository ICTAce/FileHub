@namespace ICTAce.FileHub.ApiTest
@inherits ModuleBase

<h3>ApiTest - MyModule Service Tester</h3>

<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label">Endpoint</label>
        <select class="form-select" @bind="_selectedEndpoint">
            <option value="List">List (GET)</option>
            <option value="Get">Get (GET)</option>
            <option value="Create">Create (POST)</option>
            <option value="Update">Update (PUT)</option>
            <option value="Delete">Delete (DELETE)</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Id</label>
        <input class="form-control" @bind="_id" type="number" />
    </div>
    <div class="col-md-2">
        <label class="form-label">ModuleId</label>
        <input class="form-control" @bind="_moduleId" type="number" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Page Number</label>
        <input class="form-control" @bind="_pageNumber" type="number" min="1" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Page Size</label>
        <input class="form-control" @bind="_pageSize" type="number" min="1" max="100" />
    </div>
</div>

@if (_selectedEndpoint == "Create" || _selectedEndpoint == "Update")
{
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" @bind="_name" placeholder="Enter name" />
    </div>
}

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ExecuteEndpoint">Execute</button>
</div>

@if (_loading)
{
    <p><em>Loading...</em></p>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (!string.IsNullOrEmpty(_responseStatus))
{
    <div class="mb-2"><strong>Response:</strong> @_responseStatus</div>
}

@if (!string.IsNullOrEmpty(_responseBody))
{
    <div class="card">
        <div class="card-body">
            <pre>@_responseBody</pre>
        </div>
    </div>
}
